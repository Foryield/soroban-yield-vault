# Copier vers .env.local.
# Reseau : "testnet" (defaut) ou "mainnet".
# - testnet : tous les champs ci-dessous ont des defauts publics.
# - mainnet : les identifiants de vault et NEXT_PUBLIC_RPC_URL sont
#   OBLIGATOIRES (aucun defaut, fail-closed) ; Horizon defaut
#   https://horizon.stellar.org.
#
# Une instance par actif, servies par la meme page : l'onglet est choisi dans
# l'interface, et `/?vault=eurc` ouvre directement l'instance EURC. Une
# instance dont l'identifiant est vide disparait simplement du selecteur.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_VAULT_ID=
NEXT_PUBLIC_EURC_VAULT_ID=
# Allocateur D5 (onglet USDC et dashboard /dashboard/).
NEXT_PUBLIC_USDC_VAULT_ID=
# SwapRouter D4 (panneau de reequilibrage USDC -> EURC des onglets USDC et
# EURC). Defaut testnet : le routeur mono-venue du 28/08/2026 ; vide, le
# panneau ne s'affiche pas.
NEXT_PUBLIC_SWAP_ROUTER_ID=
# Archive des events (branche data/events, tache ops-daily.yml). Defaut :
# la branche du depot public.
NEXT_PUBLIC_EVENTS_ARCHIVE_URL=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
